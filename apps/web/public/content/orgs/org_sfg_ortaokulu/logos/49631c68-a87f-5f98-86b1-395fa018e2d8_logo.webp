<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <radialGradient id="mebRed" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#e52d27"/>
      <stop offset="100%" stop-color="#b31217"/>
    </radialGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE082"/>
      <stop offset="100%" stop-color="#FFB300"/>
    </linearGradient>
  </defs>

  <!-- Outer Ring -->
  <circle cx="100" cy="100" r="96" fill="url(#mebRed)" stroke="#FFFFFF" stroke-width="4"/>
  <circle cx="100" cy="100" r="88" fill="none" stroke="url(#goldGrad)" stroke-width="2" stroke-dasharray="4,2"/>

  <!-- Ay-Yıldız (Crescent & Star) at top -->
  <g transform="translate(100, 36) scale(0.7)">
    <!-- Crescent -->
    <path d="M 0 -18 A 18 18 0 1 0 15 14 A 14 14 0 1 1 0 -18 Z" fill="#FFFFFF"/>
    <!-- Star -->
    <polygon points="12,-4 15,-1 19,-2 17,2 19,5 15,4 12,7 13,3 9,1 13,-1" fill="#FFFFFF"/>
  </g>

  <!-- Central Torch Flame -->
  <path d="M 100 52 Q 108 68 100 84 Q 92 68 100 52 Z" fill="url(#goldGrad)"/>
  <path d="M 97 60 Q 103 70 100 78 Q 94 70 97 60 Z" fill="#FFFFFF" opacity="0.8"/>

  <!-- Torch Base -->
  <path d="M 94 84 L 106 84 L 103 100 L 97 100 Z" fill="url(#goldGrad)"/>

  <!-- Open Book (Açık Kitap) -->
  <!-- Left Page -->
  <path d="M 98 104 C 80 98, 55 102, 40 114 L 40 148 C 55 136, 80 132, 98 138 Z" fill="#FFFFFF" stroke="#b31217" stroke-width="1.5"/>
  <path d="M 45 120 C 60 110, 80 108, 94 112" stroke="#e0e0e0" stroke-width="1.5" fill="none"/>
  <path d="M 45 128 C 60 118, 80 116, 94 120" stroke="#e0e0e0" stroke-width="1.5" fill="none"/>
  <path d="M 45 136 C 60 126, 80 124, 94 128" stroke="#e0e0e0" stroke-width="1.5" fill="none"/>

  <!-- Right Page -->
  <path d="M 102 104 C 120 98, 145 102, 160 114 L 160 148 C 145 136, 120 132, 102 138 Z" fill="#FFFFFF" stroke="#b31217" stroke-width="1.5"/>
  <path d="M 155 120 C 140 110, 120 108, 106 112" stroke="#e0e0e0" stroke-width="1.5" fill="none"/>
  <path d="M 155 128 C 140 118, 120 116, 106 120" stroke="#e0e0e0" stroke-width="1.5" fill="none"/>
  <path d="M 155 136 C 140 126, 120 124, 106 128" stroke="#e0e0e0" stroke-width="1.5" fill="none"/>

  <!-- Book Spine Base -->
  <polygon points="98,138 100,146 102,138" fill="url(#goldGrad)"/>

  <!-- Circular Text / Banner -->
  <text x="100" y="174" text-anchor="middle" font-family="'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="11" font-weight="900" fill="#FFFFFF" letter-spacing="1.5">
    MEB
  </text>
  <text x="100" y="188" text-anchor="middle" font-family="'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="7" font-weight="700" fill="url(#goldGrad)" letter-spacing="1">
    MİLLÎ EĞİTİM BAKANLIĞI
  </text>
</svg>
